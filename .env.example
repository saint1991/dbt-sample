# Copy this file to .env and replace these values with your dbt Platform settings.
# Use a base hostname, without https:// or the semantic-layer. prefix.
DBT_HOST=cloud.getdbt.com
DBT_PROD_ENV_ID=123456
# Use a service token with permission to query the Semantic Layer environment.
DBT_TOKEN=replace-with-your-service-token
# For accounts requiring a host prefix, uncomment and set the account prefix.
# DBT_HOST_PREFIX=your-account-prefix
